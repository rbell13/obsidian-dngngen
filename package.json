{
	"name": "dngngen",
	"version": "1.1.1",
	"description": "Render dungeons copied from DNGNGEN as structured notes for Mork Borg.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --test tests/*.test.ts",
		"check": "npm run lint && npm test && npm run build"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0"
	},
	"type": "module"
}
